programa {
  funcao inicio() {
    inteiro opcao
    real num1, num2, resultado

    faca{
      escreva("\n Calculadora \n")
      escreva("1 - Soma \n")
      escreva("2 - Substração \n")
      escreva("3 - Multiplicação \n")
      escreva("4 - Divdir \n")
      escreva("0 - Sair \n")
      escreva("Escolher uma opção: ")
      leia(opcao)
      se()
    } enquanto (opcao != 0)
  }
}
