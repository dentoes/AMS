programa {
  funcao inicio() {
   inteiro i
   real votacao, candidato_a, candidato_b, candidato_c

   escreva("Escolha em quem você deseja votar: \n 1- Candidato A\n 2- Candidato B\n 3- Candidato C\n 4- Voto Nulo\n 5- Voto em Branco\n 0- Encerrar votação\n R= ")
   leia(candidato_a)
   leia(candidato_b)
   leia(candidato_c)



   		para (i = 1; i <= 5; i++)
   {
    escreva("Digite 0 para encerrar o programa.")
   }

 }
}
